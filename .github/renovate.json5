{
  semanticCommits: 'disabled',
  dependencyDashboard: true,
  dependencyDashboardTitle: 'Renovate Dashboard',
  suppressNotifications: [
    'prIgnoreNotification',
  ],
  rebaseWhen: 'conflicted',
  prConcurrentLimit: 0,
  prHourlyLimit: 0,
  ignorePaths: [
    'provision/**',
  ],
  'helm-values': {
    managerFilePatterns: [
      '/kubernetes/.+/helm-release\\.ya?ml$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/kubernetes/.+\\.ya?ml$/',
    ],
    ignorePaths: [
      'kubernetes/bootstrap/',
    ],
  },
  flux: {
    managerFilePatterns: [
      '/kubernetes/.+\\.ya?ml$/',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/kubernetes/crds/cert-manager/.+\\.ya?ml$/',
      ],
      matchStrings: [
        'registryUrl=(?<registryUrl>.*?) chart=(?<depName>.*?)\n.*\\/(?<currentValue>.*?)\\/',
      ],
      datasourceTemplate: 'helm',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/kubernetes/bootstrap/flux-operator\\.ya?ml$/',
      ],
      matchStrings: [
        'version: "(?<currentValue>.*)"\n',
      ],
      depNameTemplate: 'controlplaneio-fluxcd/flux-operator',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.*)$',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/kubernetes/bootstrap/flux-instance\\.ya?ml$/',
      ],
      matchStrings: [
        'version: "(?<currentValue>.*)"\n',
      ],
      depNameTemplate: 'fluxcd/flux2',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.*)$',
    },
  ],
  packageRules: [
    {
      matchDatasources: [
        'helm',
      ],
      separateMinorPatch: true,
      ignoreDeprecated: true,
      commitMessageTopic: 'chart {{depName}}',
      labels: [
        'renovate/helm',
        'dep/{{updateType}}',
      ],
    },
    {
      matchDatasources: [
        'docker',
      ],
      commitMessageTopic: 'container image {{depName}}',
      commitMessageExtra: 'to {{#if isSingleVersion}}v{{{newVersion}}}{{else}}{{{newValue}}}{{/if}}',
      labels: [
        'renovate/image',
        'dep/{{updateType}}',
      ],
    },
    {
      description: 'Loose versioning for non-semver packages',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        '/plex/',
      ],
      versioning: 'loose',
    },
    {
      description: 'Catch-all by namespace; the stack groups below pull deps back out',
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      matchFileNames: [
        'kubernetes/apps/*/**',
      ],
      groupName: '{{{ replace "^kubernetes/apps/([^/]+)/.*$" "$1" packageFileDir }}} namespace',
    },
    {
      description: 'Group cohesive stacks so they land together',
      matchPackageNames: [
        '/^victoria-/',
      ],
      groupName: 'victoria-metrics stack',
    },
    {
      matchPackageNames: [
        'controlplaneio-fluxcd/flux-operator',
        'fluxcd/flux2',
      ],
      groupName: 'flux stack',
    },
    {
      description: 'Chart and CRDs must move together',
      matchPackageNames: [
        'cert-manager',
      ],
      groupName: 'cert-manager stack',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        '/sonarr/',
        '/radarr/',
        '/prowlarr/',
        '/bazarr/',
        '/cleanuparr/',
        '/flaresolverr/',
      ],
      groupName: 'arr stack',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        '/plex/',
        '/jellyfin/',
      ],
      groupName: 'streaming stack',
    },
    {
      description: 'The qbittorrent pod ships its own VPN and DNS sidecars',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        '/qbittorrent/',
        '/gluetun/',
        '/dnsdist/',
        '/qbop/',
        '/\\/qui$/',
      ],
      groupName: 'downloads stack',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        '/esphome/',
        '/mosquitto/',
        '/zigbee2mqtt/',
        '/zwave/',
      ],
      groupName: 'home-automation stack',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        '/wyoming/',
        '/speaches/',
        '/piper/',
        '/whisper/',
      ],
      groupName: 'voice stack',
    },
    {
      description: 'One PR for the chart across every release, patches included',
      matchDatasources: [
        'helm',
      ],
      matchPackageNames: [
        'app-template',
      ],
      groupName: 'app-template chart',
    },
  ],
}
